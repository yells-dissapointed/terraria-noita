Items: {
    SpellDebugWand: {
        DisplayName: Spell Debug Wand
        Tooltip:
            '''
            Left-click to test the next spell; right-click for scan controls
            Automatic scan with fresh decks and full test mana
            Harmless XML/sprite preview with labeled markers for missing visuals
            Single-player development tool
            '''
    }
    NoitaWand: {
        DisplayName: Noita Wand
        Tooltip:
            '''
            Left-click to cast; right-click to open the wand editor and cast log
            Uses its own wand mana
            Requires extracted Noita data in mod settings
            Single-player prototype
            '''
    }
}
Configs: {
    NoitaConfig: {
        DisplayName: Noita compatibility
        ExtractedDataRoot: {
            Label: Extracted Noita folder
            Tooltip: "Select the extracted Noita root, data folder, gun folder, or gun.lua file. Reload the mod after changing this."
        }
    }
}
